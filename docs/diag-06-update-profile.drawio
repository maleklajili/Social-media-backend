    <mxCell id="p4h" value=":User&#xa;Service" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="500" y="160" width="100" height="40" as="geometry"/>
