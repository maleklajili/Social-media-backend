<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="680" math="0" shadow="1">
  <root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>

    <!-- TITLE -->
    <mxCell id="t0" value="Diagramme de Séquence : Modifier le Profil" style="text;html=1;align=center;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="60" y="10" width="860" height="30" as="geometry"/>
    </mxCell>

    <!-- DESCRIPTION -->
    <mxCell id="desc" value="Description : Le client envoie PUT /user/update-profile avec un FormData et un Bearer token.&#xa;Le authMiddleware vérifie le JWT (401 si invalide). L'UserController parse les données du formulaire&#xa;via parseFormData&lt;User&gt;() puis appelle updateProfile(req, body, formData). L'UserService traite&#xa;[opt] l'upload d'image via handleFileUpload() si une image est incluse dans le FormData. Ensuite,&#xa;userRepository.updateProfile(userId, fields) effectue db.users.updateOne() pour persister les&#xa;modifications. Retourne 200 OK avec le profil mis à jour." style="text;html=1;align=left;fontSize=11;strokeColor=#666;fillColor=#f5f5f5;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="45" width="860" height="95" as="geometry"/>
    </mxCell>

    <!-- ===== PARTICIPANT HEADERS ===== -->
    <mxCell id="p1h" value=":Client" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="30" y="160" width="90" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p2h" value=":authMiddleware" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="170" y="160" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p3h" value=":User&#xa;Controller" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="345" y="160" width="100" height="40" as="geometry"/>
