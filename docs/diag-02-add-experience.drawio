<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1000" math="0" shadow="1">
  <root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>

    <!-- TITLE -->
    <mxCell id="t0" value="Diagramme de Séquence : Ajouter une Expérience" style="text;html=1;align=center;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="60" y="10" width="1000" height="30" as="geometry"/>
    </mxCell>

    <!-- DESCRIPTION -->
    <mxCell id="desc" value="Description : Le client envoie POST /experience/add-experience avec un FormData contenant les champs obligatoires&#xa;(place, post, entreprise, startDate) et optionnellement des fichiers de certifications. Le authMiddleware valide&#xa;le Bearer token. L'ExperienceController extrait le FormData et appelle ExperienceServices.addExperience().&#xa;Le service vérifie les champs requis (sinon 400). Si des certificats sont présents, il les upload via FileService&#xa;et les enregistre en base via CertificationRepository. L'expérience est insérée dans MongoDB. Ensuite,&#xa;addCoins() crédite l'utilisateur et addStandardEarning() enregistre la transaction. Retourne 200 OK." style="text;html=1;align=left;fontSize=11;strokeColor=#666;fillColor=#f5f5f5;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="45" width="1010" height="90" as="geometry"/>
    </mxCell>

