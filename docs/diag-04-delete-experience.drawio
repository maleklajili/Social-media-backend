<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="780" math="0" shadow="1">
  <root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>

    <!-- TITLE -->
    <mxCell id="t0" value="Diagramme de Séquence : Supprimer une Expérience" style="text;html=1;align=center;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="60" y="10" width="960" height="30" as="geometry"/>
    </mxCell>

    <!-- DESCRIPTION -->
    <mxCell id="desc" value="Description : Le client envoie DELETE /experience/delete-experience/:id avec un Bearer token.&#xa;Le authMiddleware vérifie le JWT. L'ExperienceController appelle deleteExperienceWithFiles(userId, id).&#xa;Le service vérifie la propriété de l'expérience via findOne({_id, userId}) — si non trouvée : 403.&#xa;Il récupère les certifications liées, supprime les fichiers physiques via FileService, puis supprime&#xa;l'expérience en base via deleteById(). Retourne 200 OK avec message de confirmation." style="text;html=1;align=left;fontSize=11;strokeColor=#666;fillColor=#f5f5f5;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="45" width="960" height="85" as="geometry"/>
    </mxCell>

    <!-- ===== PARTICIPANT HEADERS ===== -->
    <mxCell id="p1h" value=":Client" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="30" y="150" width="90" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p2h" value=":authMiddleware" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="170" y="150" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p3h" value=":Experience&#xa;Controller" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="345" y="150" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p4h" value=":Experience&#xa;Services" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="510" y="150" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="p5h" value=":FileService" style="shape=mxgraph.uml.lifeline;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="675" y="150" width="100" height="40" as="geometry"/>
