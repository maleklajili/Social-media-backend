    <!-- TITLE -->
    <mxCell id="t0" value="Diagramme de Séquence : Déconnexion (Logout)" style="text;html=1;align=center;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="60" y="10" width="860" height="30" as="geometry"/>
    </mxCell>

    <!-- DESCRIPTION -->
    <mxCell id="desc" value="Description : Le client envoie POST /auth/logout avec un Bearer token dans l'en-tête Authorization.&#xa;Le authMiddleware extrait et vérifie le JWT — si invalide : 401 Unauthorized. L'AuthController&#xa;récupère le token via getTokenFromHeaders() et appelle logout(token). L'AuthService vérifie à nouveau&#xa;le token pour extraire userId, puis supprime le RefreshToken en base via deleteByUserId().&#xa;Retourne 200 OK avec confirmation de déconnexion." style="text;html=1;align=left;fontSize=11;strokeColor=#666;fillColor=#f5f5f5;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="45" width="860" height="90" as="geometry"/>
    </mxCell>

