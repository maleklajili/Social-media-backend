    <!-- return to controller -->
    <mxCell id="m10" value="Renvoyer le profil formaté au contrôleur" style="endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="459" y="590" as="sourcePoint"/><mxPoint x="116" y="590" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- else guard -->
    <mxCell id="alt_sep" value="" style="endArrow=none;dashed=1;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="618" as="sourcePoint"/><mxPoint x="1010" y="618" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="alt_guard2" value="[token invalide / expiré]" style="text;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="175" y="620" width="180" height="16" as="geometry"/>
    </mxCell>
    <!-- 1.3: 401 Unauthorized -->
    <mxCell id="m11" value="Retourner une erreur : accès non autorisé (401)" style="endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="274" y="650" as="sourcePoint"/><mxPoint x="116" y="650" as="targetPoint"/></mxGeometry>
    </mxCell>

    <!-- final return -->
    <mxCell id="m12" value="Répondre avec le profil complet de l'utilisateur" style="endArrow=open;endFill=0;dashed=1;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="116" y="720" as="sourcePoint"/><mxPoint x="116" y="720" as="targetPoint"/>
        <Array as="points"/></mxGeometry>
    </mxCell>
    <mxCell id="ret" value="Répondre avec le profil complet de l'utilisateur" style="endArrow=open;endFill=0;dashed=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="465" y="710" as="sourcePoint"/><mxPoint x="116" y="710" as="targetPoint"/></mxGeometry>
    </mxCell>

  </root>
